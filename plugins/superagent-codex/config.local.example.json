{
  "runtime": "codex",
  "trigger": {
    "label": "superagent",
    "mention": "@superagent"
  },
  "pollSeconds": 60,
  "models": {
    "router": "<light codex model>",
    "worker": "<mid codex model>"
  },
  "worktreeRoot": "~/superagent-work",
  "watchdog": {
    "stallMinutes": 20,
    "maxRunMinutes": 120
  },
  "stateDir": "~/.superagent/state",
  "testCommand": null,
  "maxWorkers": 1,
  "promptOverlay": null,
  "policy": {
    "allowedRuntimes": [
      "claude",
      "codex"
    ],
    "maxWorkersCap": 1
  },
  "source": "local",
  "localRepos": {
    "app": "C:/path/to/your/checkout"
  },
  "router": "off",
  "budget": {
    "effort": "low",
    "routerBodyChars": 600,
    "reportWords": 120
  }
}
