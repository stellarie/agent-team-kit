{
  "runtime": "claude",
  "repos": ["your-org/your-repo"],
  "ghHost": "github.com",
  "allow": { "logins": ["your-login"] },
  "policy": {
    "allowedRuntimes": ["claude", "codex"],
    "allowedOwners": ["your-org"],
    "maxWorkersCap": 2,
    "allowOwnLogin": false,
    "forbiddenLogins": ["your-login"]
  },
  "trigger": { "label": "superagent", "mention": "@superagent" },
  "pollSeconds": 60,
  "maxWorkers": 2,
  "models": { "router": "claude-haiku-5-5", "worker": "claude-opus-5-5" },
  "worktreeRoot": "~/superagent-work",
  "watchdog": { "stallMinutes": 20, "maxRunMinutes": 120 },
  "stateDir": "~/.superagent/state",
  "promptOverlay": null,
  "testCommand": null
}
